            chaptersData.forEach(ch => {
                const card = document.createElement('div');
                card.className = 'content-card';
                let html = `<h3 style="color:var(--si-color); margin-bottom:10px;">${ch.title}</h3>`;
                if(ch.content) {
                    ch.content.forEach(item => {
                        html += `<div class="trilingual-block">
                            <div class="lang-text jp"><span class="badge badge-jp">JP</span>${item.jp}</div>
                            <div class="lang-text en"><span class="badge badge-en">EN</span>${item.en}</div>
                            <div class="lang-text si"><span class="badge badge-si">SI</span>${item.si}</div>
                        </div>`;
                    });
                }
                if(ch.subgroups) {
                    ch.subgroups.forEach(sub => {
                        html += `<div style="font-size:0.85rem; font-weight:700; color:var(--text-title); margin:8px 0 4px 0;">${sub.title}</div>`;
                        sub.items.forEach(item => {
                            html += `<div class="trilingual-block">
                                <div class="lang-text jp"><span class="badge badge-jp">JP</span>${item.jp}</div>
                                <div class="lang-text en"><span class="badge badge-en">EN</span>${item.en}</div>
                                <div class="lang-text si"><span class="badge badge-si">SI</span>${item.si}</div>
                            </div>`;
                        });
                    });
                }
                card.innerHTML = html;
                container.appendChild(card);
            });
        }

        function renderQA() {
            const container = document.getElementById('qaContainer');
            container.innerHTML = '';
            qaData.forEach(q => {
                const isDone = doneQA.includes(q.id);
                const isStarred = starQA.includes(q.id);
                const card = document.createElement('div');
                card.className = 'content-card';
                card.innerHTML = `
                    <div class="qa-header">
                        <span class="qa-num">Q${q.id}</span>
                        <div>
                            <button class="action-btn ${isDone ? 'done' : ''}" onclick="toggleDone(${q.id})">✓ Done</button>
