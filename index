        function renderVocabCategories() {
            const dashTiles = document.getElementById('dashTilesPreview');
            const mainTiles = document.getElementById('vocabCategoriesTiles');
            const senseiSubTiles = document.getElementById('senseiVocabSubTilesContainer');
            
            if(dashTiles) dashTiles.innerHTML = '';
            if(mainTiles) mainTiles.innerHTML = '';
            if(senseiSubTiles) senseiSubTiles.innerHTML = '';

            vocabCategoriesData.forEach((cat, idx) => {
                const tile = document.createElement('div');
                tile.className = 'tile-card';
                tile.onclick = () => openVocabCards(cat.id);

                const masteredInCat = cat.words.filter(w => masteredVocab.includes(w.id)).length;

                tile.innerHTML = `
                    <div class="tile-header">
                        <span class="tile-icon" style="font-size:1.2rem;">${cat.icon}</span>
                        <span class="tile-count">${masteredInCat}/${cat.words.length}</span>
                    </div>
                    <div class="tile-title">${cat.name}</div>
                `;

                if(mainTiles) mainTiles.appendChild(tile);
                
                if(idx < 4 && dashTiles) {
                    const dashTile = tile.cloneNode(true);
                    dashTile.onclick = () => { switchTab('vocab'); openVocabCards(cat.id); };
                    dashTiles.appendChild(dashTile);
                }

                // Sensei Sub-Tiles for Vocab Mode
                if(senseiSubTiles) {
                    const senseiSubTile = document.createElement('div');
                    senseiSubTile.className = 'tile-card';
                    senseiSubTile.style.minHeight = '65px';
                    senseiSubTile.onclick = () => selectSenseiVocabCategory(cat.id, senseiSubTile);
