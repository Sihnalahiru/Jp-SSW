        let masteredVocab = JSON.parse(localStorage.getItem('ssw_mastered_vocab') || '[]');
        let userXP = parseInt(localStorage.getItem('ssw_user_xp') || '0');
        let currentTheme = localStorage.getItem('ssw_theme') || 'dark';
        let senseiWeaknesses = JSON.parse(localStorage.getItem('ssw_sensei_weaknesses') || '[]');

        document.documentElement.setAttribute('data-theme', currentTheme);

        function saveState() {
            localStorage.setItem('ssw_done_qa', JSON.stringify(doneQA));
            localStorage.setItem('ssw_star_qa', JSON.stringify(starQA));
            localStorage.setItem('ssw_mastered_vocab', JSON.stringify(masteredVocab));
            localStorage.setItem('ssw_user_xp', userXP.toString());
            localStorage.setItem('ssw_theme', currentTheme);
            localStorage.setItem('ssw_sensei_weaknesses', JSON.stringify(senseiWeaknesses));
            updateStats();
        }

        function toggleTheme() {
            currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', currentTheme);
            saveState();
        }

        function toggleDone(id) {
            if(doneQA.includes(id)) doneQA = doneQA.filter(i => i !== id);
            else doneQA.push(id);
            saveState(); renderQA();
        }

        function toggleStar(id) {
            if(starQA.includes(id)) starQA = starQA.filter(i => i !== id);
            else starQA.push(id);
            saveState(); renderQA();
        }

        function toggleVocabMastered(wordId) {
            if(masteredVocab.includes(wordId)) {
                masteredVocab = masteredVocab.filter(i => i !== wordId);
            } else {
                masteredVocab.push(wordId);
                userXP += 5;
            }
            saveState();
            renderVocabCategories();
            if(activeCategoryId) renderVocabCards(activeCategoryId);
        }

        function updateStats() {
            document.getElementById('doneQA').innerText = `${doneQA.length}/69`;
            document.getElementById('starQA').innerText = starQA.length;
            document.getElementById('progressPct').innerText = `${Math.round((doneQA.length / 69) * 100)}%`;
            document.getElementById('vocabMasteredCount').innerText = `${masteredVocab.length}/360`;
            document.getElementById('xpVal').innerText = userXP;

            let levelTitle = "研修生 (Trainee)";
            let nextXp = 100;
            let fillPct = (userXP / 100) * 100;

            if (userXP >= 600) {
                levelTitle = "おもてなし達人 (Master)"; nextXp = 1000; fillPct = 100;
            } else if (userXP >= 300) {
                levelTitle = "主任 (Supervisor)"; nextXp = 600; fillPct = ((userXP - 300) / 300) * 100;
            } else if (userXP >= 100) {
                levelTitle = "フロント係 (Staff)"; nextXp = 300; fillPct = ((userXP - 100) / 200) * 100;
            }

            document.getElementById('levelTitle').innerText = levelTitle;
            document.getElementById('nextXpVal').innerText = nextXp;
            document.getElementById('xpBarFill').style.width = `${Math.min(100, fillPct)}%`;
        }

