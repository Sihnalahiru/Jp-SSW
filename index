                    `;
                });
                card.innerHTML = html;
                container.appendChild(card);
            });
        }

        // TAB SWITCHER
        function switchTab(tabId, btn) {
            if(btn) {
                document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
            ['dash', 'chapters', 'qa', 'vocab', 'conv', 'ai'].forEach(s => {
                document.getElementById(s + 'Screen').classList.add('hidden');
            });
            document.getElementById(tabId + 'Screen').classList.remove('hidden');

            if(tabId === 'vocab') backToCategories();
            if(tabId === 'ai') generateSenseiQuestion();
        }

        // GLOBAL SEARCH
        function globalSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            if(!query) { renderQA(); return; }
            switchTab('qa');
            const filtered = qaData.filter(q => 
                q.q_jp.toLowerCase().includes(query) ||
                q.q_en.toLowerCase().includes(query) ||
                q.q_si.toLowerCase().includes(query) ||
                q.a_jp.toLowerCase().includes(query) ||
                q.a_en.toLowerCase().includes(query) ||
                q.a_si.toLowerCase().includes(query)
            );
            const container = document.getElementById('qaContainer');
            container.innerHTML = '';
            filtered.forEach(q => {
                const card = document.createElement('div');
                card.className = 'content-card';
                card.innerHTML = `
                    <div class="qa-header"><span class="qa-num">Q${q.id}</span></div>
                    <div class="lang-text jp"><span class="badge badge-jp">JP</span>${q.q_jp}</div>
                    <div class="lang-text si"><span class="badge badge-si">SI</span>${q.q_si}</div>
                    <div class="lang-text jp" style="margin-top:6px;"><span class="badge badge-jp">Ans</span>${q.a_jp}</div>
                `;
                container.appendChild(card);
            });
        }

        // AI HOTEL SENSEI LOGIC (6 MODES + CATEGORY TILES + ADAPTIVE WEAKNESS + SUGGESTED HINT)
        let currentSenseiMode = 'customer';
        let activeSenseiVocabCatId = 1;
        let currentQuestionObj = null;

        const senseiScenarios = {
            customer: [
                { q_jp: "いらっしゃいませ。本日ご予約のお客様でいらっしゃいますか。", q_en: "Welcome! Are you arriving for check-in today?", q_si: "සාදරයෙන් පිළිගනිමු! ඔබ අද දිනයේ වෙන්කරවාගත් අමුත්තාද?", ans_jp: "はい、予約したスリランカのタリンダです。", ans_en: "Yes, I am Tharinda from Sri Lanka who booked.", ans_si: "ඔව්, මම වෙන් කරවා ගත් ශ්‍රී ලංකාවේ තලින්ද." },
                { q_jp: "チェックアウトをお願いします。鍵を返却いたします。", q_en: "I'd like to check out. Returning the room key.", q_si: "කාමරයෙන් Check-out වීමට අවශ්‍යයි. යතුර භාරදෙමි.", ans_jp: "ご利用ありがとうございました。お会計を確認いたします。", ans_en: "Thank you for staying. I will confirm your bill.", ans_si: "නවාතැන් ගැනීම ගැන ස්තූතියි. ගෙවීම් පරීක්ෂා කරන්නම්." }
            ],
            manager: [
                { q_jp: "本日の朝食会場の準備は整っていますか。", q_en: "Is the breakfast venue preparation ready today?", q_si: "අද උදෑසන ආහාර ස්ථානයේ සූදානම අවසන්ද?", ans_jp: "はい、テーブルと料理の準備はすべて完了しております。", ans_en: "Yes, table and food prep are all complete.", ans_si: "ඔව්, මේස සහ ආහාර සියල්ල සූදානම්." }
            ],
            coworker: [
                { q_jp: "次のシフトへの引き継ぎ（ほうれんそう）事項はありますか。", q_en: "Are there handover (Horenso) items for the next shift?", q_si: "ඊළඟ සේවා මුරයට භාරදීමට යම් වාර්තාවක් තිබේද?", ans_jp: "はい、502号室のお客様から毛布の追加要望がございました。", ans_en: "Yes, room 502 requested an extra blanket.", ans_si: "ඔව්, 502 කාමරයේ අමුත්තා අමතර පොරවනයක් ඉල්ලා සිටියා." }
            ],
            phone: [
                { q_jp: "お電話ありがとうございます。○○ホテルでございます。", q_en: "Thank you for calling. This is OO Hotel.", q_si: "දුරකථන ඇමතුමට ස්තූතියි. මෙය OO හෝටලයයි.", ans_jp: "恐れ入りますが、明日の空室状況を確認していただけますか。", ans_en: "Could you please check tomorrow's room availability?", ans_si: "කරුණාකර හෙට දිනයේ කාමර තිබේදැයි පරීක්ෂා කළ හැකිද?" }
            ],
            emergency: [
                { q_jp: "緊急事態です！地震が発生しました。どう対応しますか。", q_en: "Emergency! An earthquake occurred. How to respond?", q_si: "හදිසි අවස්ථාවක්! භූමිකම්පාවක් ඇතිවිය. කුමක් කරන්නේද?", ans_jp: "お客様の安全を確保し、机の下へ案内します！エレベーターは禁止です！", ans_en: "Ensure guest safety, guide under tables! No elevators!", ans_si: "පාරිභෝගික ආරක්ෂාව තහවුරු කර මේස යටට යොමු කරන්න! විදුලි පඩිපෙළ තහනම්!" }
            ]
        };

        function setSenseiMode(mode, element) {
            currentSenseiMode = mode;
            document.querySelectorAll('.sensei-tile-card').forEach(b => b.classList.remove('active'));
            if(element) element.classList.add('active');

            const subTilesEl = document.getElementById('senseiVocabSubTilesContainer');
            if(mode === 'vocab') {
                subTilesEl.classList.remove('hidden');
            } else {
                subTilesEl.classList.add('hidden');
            }
            generateSenseiQuestion();
        }

        function selectSenseiVocabCategory(catId, element) {
            activeSenseiVocabCatId = catId;
            document.querySelectorAll('#senseiVocabSubTilesContainer .tile-card').forEach(b => b.classList.remove('active'));
            if(element) element.classList.add('active');
            generateSenseiQuestion();
        }

        function generateSenseiQuestion() {
            document.getElementById('suggestedAnswerBox').classList.add('hidden');

            if(currentSenseiMode === 'vocab') {
                const cat = vocabCategoriesData.find(c => c.id === activeSenseiVocabCatId) || vocabCategoriesData[0];
                const randomWord = cat.words[Math.floor(Math.random() * cat.words.length)];
                currentQuestionObj = {
                    q_jp: `「${randomWord.kanji} (${randomWord.kana})」の意味とホテルの使い方を教えてください。`,
                    q_en: `What is the meaning and hotel usage of '${randomWord.kanji}' (${randomWord.en})?`,
                    q_si: `'${randomWord.kanji}' (${randomWord.si}) හි තේරුම සහ භාවිතය කුමක්ද?`,
                    ans_jp: `${randomWord.kanji}は「${randomWord.si}」という意味です。`,
                    ans_en: `${randomWord.kanji} means '${randomWord.en}'.`,
                    ans_si: `${randomWord.kanji} යනු '${randomWord.si}' යන්නයි.`
                };
            } else {
                const scenarioList = senseiScenarios[currentSenseiMode] || senseiScenarios.customer;
                currentQuestionObj = scenarioList[Math.floor(Math.random() * scenarioList.length)];
            }

            document.getElementById('aiQuestionText').innerHTML = `
                <div style="font-size:0.9rem; font-weight:700; color:var(--jp-color); margin-bottom:4px;">${currentQuestionObj.q_jp}</div>
                <div style="font-size:0.75rem; color:var(--en-color);">${currentQuestionObj.q_en}</div>
                <div style="font-size:0.75rem; color:var(--si-color);">${currentQuestionObj.q_si}</div>
            `;

            document.getElementById('suggestJp').innerText = currentQuestionObj.ans_jp;
            document.getElementById('suggestEn').innerText = currentQuestionObj.ans_en;
            document.getElementById('suggestSi').innerText = currentQuestionObj.ans_si;

            speakJapaneseVoice(currentQuestionObj.q_jp);
        }

        function toggleSuggestedAnswer() {
            document.getElementById('suggestedAnswerBox').classList.toggle('hidden');
        }

        function submitSenseiAnswer() {
            const input = document.getElementById('senseiTextInput');
            const val = input.value.trim();
            if(!val) return;

            document.getElementById('transcriptBox').innerHTML += `
                <div style="color:var(--en-color); font-weight:700; margin-top:8px;">You Answered:</div>
                ${val}
            `;

            input.value = '';
            userXP += 10;
            saveState();

            setTimeout(() => {
                document.getElementById('transcriptBox').innerHTML += `
                    <div style="color:var(--accent-green); font-weight:700; margin-top:8px;">AI Sensei Feedback:</div>
                    素晴らしいですね！(+10 XP) 正しいおもてなし対応です。(Great response! Proper Keigo hospitality.)
                `;
                speakJapaneseVoice("素晴らしいですね！正しい対応です。");
            }, 500);
        }

        // LIVE VOICE (STT & TTS)
        let isListening = false;
        let recognition = null;

        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.lang = 'ja-JP';
            recognition.continuous = false;
            recognition.interimResults = false;

            recognition.onstart = () => {
                isListening = true;
                document.getElementById('micBtn').classList.add('listening');
                document.getElementById('pulseRing').classList.add('active');
                document.getElementById('callStatus').innerText = "Listening in Japanese... (話し手を聴いています)";
            };

            recognition.onresult = (event) => {
                const userSpeech = event.results[0][0].transcript;
                document.getElementById('senseiTextInput').value = userSpeech;
                submitSenseiAnswer();
            };

            recognition.onerror = () => { stopLiveVoice(); };
            recognition.onend = () => { stopLiveVoice(); };
        }

        function toggleVoiceLive() {
            if(!recognition) { alert("Speech recognition is not supported in this browser. Please use Chrome."); return; }
            if(isListening) { recognition.stop(); stopLiveVoice(); }
            else { recognition.start(); }
        }

        function stopLiveVoice() {
            isListening = false;
            document.getElementById('micBtn').classList.remove('listening');
            document.getElementById('pulseRing').classList.remove('active');
            document.getElementById('callStatus').innerText = "AI Sensei Live Call Ready";
        }

        function speakJapaneseVoice(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'ja-JP';
                utterance.rate = 0.88;
                window.speechSynthesis.speak(utterance);
            }
        }

        // INIT APP
        renderChapters();
        renderQA();
        renderVocabCategories();
        renderConv();
        updateStats();
    </script>
</body>
</html>
